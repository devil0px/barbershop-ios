<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark theme to match app dark UI — prevents white flash on startup -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">#FF121212</item>
        <item name="android:navigationBarColor">#FF1A1A1A</item>
    </style>
    <!-- NormalTheme: dark window background to prevent flash -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">#FF1A1A1A</item>
        <item name="android:statusBarColor">#FF121212</item>
        <item name="android:navigationBarColor">#FF1A1A1A</item>
    </style>
</resources>
